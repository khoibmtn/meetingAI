# =============================================================================
# MeetingAI — biến môi trường
# Sao chép thành .env.local khi chạy cục bộ; trên Vercel đặt ở
# Project → Settings → Environment Variables.
# =============================================================================

# --- Supabase (bắt buộc) ------------------------------------------------------
# Project Settings → API Keys. Hỗ trợ cả khoá mới (sb_publishable_/sb_secret_)
# lẫn khoá cũ (anon/service_role).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=           # thay cho dòng trên nếu dùng khoá cũ
SUPABASE_SECRET_KEY=sb_secret_xxx           # CHỈ đặt ở server, không có tiền tố NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=               # thay cho dòng trên nếu dùng khoá cũ

# --- Bảo mật (bắt buộc) -------------------------------------------------------
# Mã hoá AES-256-GCM cho API key và refresh token lưu trong CSDL.
# Tạo: openssl rand -base64 32   — ĐỪNG đổi sau khi đã lưu khoá (sẽ phải nhập lại).
APP_ENCRYPTION_KEY=
# Bí mật giữa các bước xử lý nền (mặc định dùng APP_ENCRYPTION_KEY).
WORKER_SECRET=
# Bí mật cho Vercel Cron gọi /api/cron/watchdog (Vercel tự gửi "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# --- Google Drive (bắt buộc để lưu tệp ghi âm) --------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Redirect URI: https://<tên-miền>/api/admin/drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tuỳ chọn: dùng refresh token cố định thay cho nút "Kết nối Google Drive" trong trang Quản trị.
# GOOGLE_DRIVE_REFRESH_TOKEN=
# Tuỳ chọn: thư mục đích (mặc định tự tạo "MeetingAI - Ghi âm").
# GOOGLE_DRIVE_FOLDER_ID=

# --- URL ứng dụng --------------------------------------------------------------
# Nên đặt ở production để worker nền tự gọi đúng tên miền.
APP_URL=http://localhost:3000
# Nếu bật Vercel Deployment Protection cho production: Settings → Deployment Protection
# → Protection Bypass for Automation, rồi đặt giá trị vào đây.
# VERCEL_AUTOMATION_BYPASS_SECRET=

# --- Giới hạn đăng ký (tuỳ chọn) ------------------------------------------------
# Chỉ cho phép email thuộc các tên miền này đăng nhập, phân tách bằng dấu phẩy.
# ALLOWED_EMAIL_DOMAINS=benhvien.vn

# --- Khoá AI dự phòng (tuỳ chọn) ------------------------------------------------
# Khuyến nghị cấu hình trong Quản trị → Kết nối AI (có kiểm tra, phân công theo vị trí).
# Các biến dưới đây chỉ dùng khi chưa có kết nối hợp lệ nào.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# SONIOX_API_KEY=

# --- Khác (tuỳ chọn) ------------------------------------------------------------
# Đường dẫn ffmpeg tự cài (mặc định dùng ffmpeg-static đi kèm).
# FFMPEG_PATH=/usr/bin/ffmpeg
